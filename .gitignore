.DS_Store

# build artifacts. The narray-generated files (src/device.h, src/pinmux.h,
# src/devs.ld, src/STM32G474Exx_RAM.ld) and the lib copies in src/nlib/ are
# NOT ignored: they are the vendored [N]Array sources this repo builds from,
# and `make -C src n-array-clean` is what refreshes them. See src/Makefile.
*.o
*.elf
*.bin
*.hex
*.map
/bmp390inv/golden
/rb01tool/rb01tool
/fdm/turncheck
/fdm/sitljson
__pycache__/
/src/mav.parm
/src/mav.tlog*
/tools/bench/bench
/tools/bench/bench-linux-arm64
/tools/bench/*.csv

# px4hil is a Go build product
/tools/px4hil/px4hil
