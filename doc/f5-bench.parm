# f5-bench.parm — NucleoF767ZI + rotanimb01 harness, first HITL checkride.
# Load: MAVProxy `param load doc/f5-bench.parm`, then `reboot`.
# Tree is post-4.6: GPS param family is GPS1_*, not GPS_*.

# --- board: no safety switch on the Nucleo; PWM stays dead without this
BRD_SAFETY_DEFLT 0

# --- DroneCAN: harness FDCAN3 feeds Fix2 + RawAirData + NodeStatus (node 42)
CAN_P1_DRIVER    1
CAN_D1_PROTOCOL  1
GPS1_TYPE        9
ARSPD_TYPE       8
ARSPD_USE        1
# the harness diff pressure is exactly 0.5*rho0*IAS^2 — offset 0 IS the truth,
# and skipping boot cal protects against rebooting the DUT mid-flight.
# RATIO must be 2/rho0 = 1.6327, NOT the 2.0 default: at default the DUT
# reads IAS 10.7% high (caught night 7: GPS 41.8 m/s vs IAS 45.7 zero-wind)
ARSPD_SKIP_CAL   1
ARSPD_OFFSET     0
ARSPD_RATIO      1.6327

# --- RC comes from GCS overrides (no receiver on the bench)
RC_OVERRIDE_TIME 3
THR_FAILSAFE     0
FS_SHORT_ACTN    0
FS_LONG_ACTN     0
FS_GCS_ENABL     0

# --- bench comfort
RTL_AUTOLAND     2
LOG_DISARMED     0
LOG_BACKEND_TYPE 0

# --- mark the 3D accel cal done (SITL convention): the FDM serves a constant
#     level -1 g, so the real 6-pose dance is impossible; these tiny values
#     satisfy accel_calibrated_ok_all with negligible (0.1%) scale error
INS_ACCOFFS_X    0.001
INS_ACCOFFS_Y    0.001
INS_ACCOFFS_Z    0.001
INS_ACCSCAL_X    1.001
INS_ACCSCAL_Y    1.001
INS_ACCSCAL_Z    1.001

# mandatory-check clearances discovered on the bench 2026-07-15:
# caltemp -300 = "never calibrated" sentinel; the crash dump ignore is for
# the bench only (a real vehicle should investigate its dumps)
INS_ACC1_CALTEMP 25
ARMING_CRSDP_IGN 1

# --- Kitfox airframe basics (first tuning pass, bench night 2):
# default loiter radius 60 m at default speeds demanded 70-deg banks
AIRSPEED_CRUISE  38   # the model's true cruise (45% throttle) = the reference aircraft's 90 kt
AIRSPEED_MIN     21
AIRSPEED_MAX     46
WP_LOITER_RAD    553  # standard-loiter default; see leg definitions below
TRIM_THROTTLE    45

# --- night-3 additions: TECS energy limits from the model's measured
# performance (golden: Vy climb 5.8 m/s); gentler L1
TECS_CLMB_MAX    5
TECS_SINK_MIN    2.8
TECS_SINK_MAX    6
NAVL1_PERIOD     17   # night-5 sweep value; with the pitch tune in, capture
                      # is clean here — no need for further reduction
ROLL_LIMIT_DEG   40
PTCH_LIM_MAX_DEG 20
PTCH_LIM_MIN_DEG -18

# --- AUTOTUNE-learned ROLL gains (night 4, A/B-validated: mission completes,
# no departures). This airframe wants ~9x the default FF: low control
# authority (53 deg/s full aileron). NOTE: AP_AutoTune RESTORES gains on
# mode exit unless both D and P limits were found — read gains while still
# in the mode (`bench tune` does). NIGHT-7 TRAP: even a completed
# autotune only holds its gains in RAM — the first DUT reboot after
# night 4 silently reverted these to defaults, and the whole night-5
# "L1 loiter mystery" was flown on DEFAULT roll gains (4.7 s
# roll-vs-demand lag inside L1's loop = limit cycle). param_set them
# explicitly (that persists) and VERIFY by readback each session start.
RLL_RATE_FF      3.0047
RLL_RATE_P       4.8389
RLL_RATE_I       0.15
RLL_RATE_D       0.3832

# --- AUTOTUNE-learned PITCH gains (SITL rig, 2026-07-16): the bench
# ladders kept dying at the altitude floor; the same fdm.c under
# ArduPilot's SITL JSON backend (fdm/sitljson, tools/bench)
# completed both ladders cleanly at 10x real-time. FF matches the ~1.65
# the bench converged to twice. A/B in SITL: these gains -> both loiter
# legs textbook (ias exact, R +3%); default pitch -> the whole night-5
# pathology reproduces (ias +9 over command, phugoid, saturated bank).
# The L1 "capture mystery" was the pitch loop all along: TECS couldn't
# place pitch, energy control fell into a phugoid, L1 never got its
# geometry.
PTCH_RATE_FF     1.6387
PTCH_RATE_P      8.3447
PTCH_RATE_I      6.2585
PTCH_RATE_D      0.4981
PTCH2SRV_TCONST  0.75
PTCH_RATE_FLTT   2.1221

# --- night-6: TAKEOFF-mode no-rotation was the controllers intermittently
# flying DCM's attitude, corrupted by the (realistic) gyro bias walk while
# EKF3 tracked fine. Fixed-wing DCM fallback off:
AHRS_OPTIONS     1

# --- TAKEOFF-mode departure (replaces the scripted FBWA climb)
TKOFF_ROTATE_SPD 26
TKOFF_ALT        150
TKOFF_LVL_ALT    30
TKOFF_DIST       800
TKOFF_LVL_PITCH  12
TKOFF_THR_MAX    100
# MUST be 0 for a wheeled standing start: nonzero suppresses throttle
# until GPS speed exceeds it (hand-launch feature) = deadlock
TKOFF_THR_MINSPD 0

# --- loiter leg definitions (reference legs): standard = 3 deg/s at
# (cruise+stall)/2 = 29 m/s -> R 553 m (bank 8.8); fast = 6 deg/s at
# cruise 38 -> R 363 m (bank 22). WP_LOITER_RAD latches at LOITER entry;
# DO_CHANGE_SPEED is inert in LOITER — set AIRSPEED_CRUISE live instead.
