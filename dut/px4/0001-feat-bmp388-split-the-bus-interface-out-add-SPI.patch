+/**
+ * @file bmp388_spi.cpp
+ *
+ * SPI interface for the BMP388/BMP390.
+ *
+ * 4-wire SPI (BMP390 datasheet section 5.3): a read sends 0x80 | reg_addr and
+ * the part inserts ONE dummy byte before the first data byte; a write sends
+ * reg_addr with bit 7 clear followed by the data. The part auto-detects mode 0
+ * or mode 3 per transaction, so either works on real silicon -- the bus mode is
+ * left to the caller (-m on the command line).
+ */
+
+#include "bmp388.h"
+
+#include <lib/drivers/device/spi.h>
+
+#if defined(CONFIG_SPI)
+
+static constexpr uint8_t DIR_READ = (1 << 7);
+
+class BMP388_SPI : public device::SPI
+{
+public:
+	BMP388_SPI(int bus, uint32_t device, int bus_frequency, spi_mode_e spi_mode);
+	~BMP388_SPI() override = default;
+
+	int read(unsigned address, void *data, unsigned count) override;
+	int write(unsigned address, void *data, unsigned count) override;
+};
+
+device::Device *BMP388_SPI_interface(int bus, uint32_t devid, int bus_frequency, spi_mode_e spi_mode)
+{
+	return new BMP388_SPI(bus, devid, bus_frequency, spi_mode);
+}
+
+BMP388_SPI::BMP388_SPI(int bus, uint32_t device, int bus_frequency, spi_mode_e spi_mode) :
+	SPI(DRV_BARO_DEVTYPE_BMP388, MODULE_NAME, bus, device, spi_mode, bus_frequency)
+{
+}
+
+int BMP388_SPI::read(unsigned address, void *data, unsigned count)
+{
+	// command byte + one dummy byte the part inserts + the data
+	uint8_t buf[32];
+
+	if (sizeof(buf) < count + 2) {
+		return -EIO;
+	}
+
+	buf[0] = address | DIR_READ;
+
+	const int ret = transfer(&buf[0], &buf[0], count + 2);
+
+	if (ret == PX4_OK) {
+		memcpy(data, &buf[2], count);
+	}
+
+	return ret;
+}
+
+int BMP388_SPI::write(unsigned address, void *data, unsigned count)
+{
+	uint8_t buf[32];
+
+	if (sizeof(buf) < count + 1) {
+		return -EIO;
+	}
+
+	buf[0] = address & 0x7f;
+	memcpy(&buf[1], data, count);
+
+	return transfer(&buf[0], nullptr, count + 1);
+}
+
+#endif // CONFIG_SPI
