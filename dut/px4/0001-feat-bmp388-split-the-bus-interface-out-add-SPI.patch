 src/drivers/barometer/bmp388/bmp388.cpp      |  34 +++---
 src/drivers/barometer/bmp388/bmp388.h        |  26 ++++-
 src/drivers/barometer/bmp388/bmp388_i2c.cpp  |  89 +++++++++++++++
 src/drivers/barometer/bmp388/bmp388_main.cpp |  53 ++++++++-
 src/drivers/barometer/bmp388/bmp388_spi.cpp  | 109 +++++++++++++++++++
 6 files changed, 286 insertions(+), 27 deletions(-)
 create mode 100644 src/drivers/barometer/bmp388/bmp388_i2c.cpp
 create mode 100644 src/drivers/barometer/bmp388/bmp388_spi.cpp

