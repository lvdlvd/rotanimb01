+#if defined(CONFIG_SPI)
+extern device::Device *BMP388_SPI_interface(int bus, uint32_t devid, int bus_frequency, spi_mode_e spi_mode);
+#endif // CONFIG_SPI
+#if defined(CONFIG_I2C)
+extern device::Device *BMP388_I2C_interface(int bus, uint8_t address, int bus_frequency);
+#endif // CONFIG_I2C
