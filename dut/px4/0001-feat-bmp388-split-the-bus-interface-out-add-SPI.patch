+
+/**
+ * @file bmp388_i2c.cpp
+ *
+ * I2C interface for the BMP388/BMP390: register address, then data, no dummy
+ * byte and no direction bit.
+ */
+
+#include "bmp388.h"
+
+#include <lib/drivers/device/i2c.h>
+
+#if defined(CONFIG_I2C)
+
+class BMP388_I2C : public device::I2C
+{
+public:
+	BMP388_I2C(int bus, uint8_t address, int bus_frequency);
+	~BMP388_I2C() override = default;
+
+	int read(unsigned address, void *data, unsigned count) override;
+	int write(unsigned address, void *data, unsigned count) override;
+};
+
+device::Device *BMP388_I2C_interface(int bus, uint8_t address, int bus_frequency)
+{
+	return new BMP388_I2C(bus, address, bus_frequency);
+}
+
+BMP388_I2C::BMP388_I2C(int bus, uint8_t address, int bus_frequency) :
+	I2C(DRV_BARO_DEVTYPE_BMP388, MODULE_NAME, bus, address, bus_frequency)
+{
+	_retries = 1;
+}
+
+int BMP388_I2C::read(unsigned address, void *data, unsigned count)
+{
+	const uint8_t cmd = address;
+	return transfer(&cmd, 1, static_cast<uint8_t *>(data), count);
+}
+
+int BMP388_I2C::write(unsigned address, void *data, unsigned count)
+{
+	uint8_t buf[32];
+
+	if (sizeof(buf) < count + 1) {
+		return -EIO;
+	}
+
+	buf[0] = address;
+	memcpy(&buf[1], data, count);
+
+	return transfer(&buf[0], count + 1, nullptr, 0);
+}
+
+#endif // CONFIG_I2C
diff --git a/src/drivers/barometer/bmp388/bmp388_main.cpp b/src/drivers/barometer/bmp388/bmp388_main.cpp
index 3420d1e1f2..1b29c6186d 100644
--- a/src/drivers/barometer/bmp388/bmp388_main.cpp
+++ b/src/drivers/barometer/bmp388/bmp388_main.cpp
@@ -38,12 +38,56 @@
 
 #include <string.h>
 
+I2CSPIDriverBase *BMP388::instantiate(const I2CSPIDriverConfig &config, int runtime_instance)
+{
+	device::Device *interface = nullptr;
+
+#if defined(CONFIG_I2C)
+
+	if (config.bus_type == BOARD_I2C_BUS) {
+		interface = BMP388_I2C_interface(config.bus, config.i2c_address, config.bus_frequency);
+
+	} else
+#endif // CONFIG_I2C
+#if defined(CONFIG_SPI)
+		if (config.bus_type == BOARD_SPI_BUS) {
+			interface = BMP388_SPI_interface(config.bus, config.spi_devid, config.bus_frequency, config.spi_mode);
+		}
+
+#endif // CONFIG_SPI
+
+	if (interface == nullptr) {
+		PX4_ERR("alloc failed");
+		return nullptr;
+	}
+
+	if (interface->init() != OK) {
+		delete interface;
+		PX4_DEBUG("no device on bus %i", config.bus);
+		return nullptr;
+	}
+
+	BMP388 *dev = new BMP388(interface, config);
+
+	if (dev == nullptr) {
+		delete interface;
+		return nullptr;
+	}
+
+	if (dev->init() != OK) {
+		delete dev;
+		return nullptr;
+	}
+
+	return dev;
+}
+
 void BMP388::print_usage()
 {
 	PRINT_MODULE_USAGE_NAME("bmp388", "driver");
 	PRINT_MODULE_USAGE_SUBCATEGORY("baro");
 	PRINT_MODULE_USAGE_COMMAND("start");
-	PRINT_MODULE_USAGE_PARAMS_I2C_SPI_DRIVER(true, false);
+	PRINT_MODULE_USAGE_PARAMS_I2C_SPI_DRIVER(true, true);
 	PRINT_MODULE_USAGE_PARAMS_I2C_ADDRESS(0x76);
 	PRINT_MODULE_USAGE_DEFAULT_COMMANDS();
 }
@@ -51,9 +95,14 @@ void BMP388::print_usage()
 extern "C" int bmp388_main(int argc, char *argv[])
 {
 	using ThisDriver = BMP388;
-	BusCLIArguments cli{true, false};
+	BusCLIArguments cli{true, true};
+#if defined(CONFIG_I2C)
 	cli.i2c_address = 0x76;
 	cli.default_i2c_frequency = I2C_SPEED;
+#endif // CONFIG_I2C
+#if defined(CONFIG_SPI)
+	cli.default_spi_frequency = SPI_SPEED;
+#endif // CONFIG_SPI
 
 	const char *verb = cli.parseDefaultArguments(argc, argv);
 
