--- /dev/null
+++ b/boards/st/nucleo-f767zi/init/rc.board_defaults
@@ -0,0 +1,26 @@
+#!/bin/sh
+#
+# NUCLEO-F767ZI HITL DUT board defaults
+#------------------------------------------------------------------------------
+
+# The board this firmware runs on is a bare NUCLEO-F767ZI: no SD card, no FRAM,
+# no battery monitor, no RC receiver, no buzzer, no safety switch.
+
+# There is no persistent filesystem, so the mission/geofence store has to live
+# in RAM. Left at the default the dataman module tries /fs/microsd, fails, and
+# the navigator then retries its safe-point cache forever (which also drowns
+# the 57600-baud console).
+param set-default SYS_DM_BACKEND 1
+
+# No battery monitoring of any kind, so the system-power preflight check has
+# nothing to look at: open its circuit breaker (the magic value is the one
+# CBRK_SUPPLY_CHK documents).
+param set-default BAT1_SOURCE 1
+param set-default CBRK_SUPPLY_CHK 894281
+
+# There is no RC receiver: the bench flies missions and external-mode setpoints.
+param set-default COM_RC_IN_MODE 4
+
+# The bench aircraft. Airframe 2110 carries the Kitfox model constants, the
+# harness's PWM channel order and the DroneCAN sensor config.
+param set-default SYS_AUTOSTART 2110
diff --git a/boards/st/nucleo-f767zi/init/rc.board_sensors b/boards/st/nucleo-f767zi/init/rc.board_sensors
new file mode 100644
index 0000000000..69eee9d892
--- /dev/null
+++ b/boards/st/nucleo-f767zi/init/rc.board_sensors
@@ -0,0 +1,34 @@
+#!/bin/sh
+#
+# NUCLEO-F767ZI HITL DUT sensor init
+#
+# The whole "sensor suite" is one STM32G474 (the rotanimb01 harness) emulating
+# a BMI088 + BMP390 + RM3100 at the SPI register level on SPI3, chip selects
+# PD3/PD4/PD5/PD6. There is nothing else on the bus and no DRDY wiring.
+#
+#   -m 0  MANDATORY on every device. Real BMI088/BMP390/RM3100 silicon
+#         auto-detects the SPI clock phase per transaction; a register-level
+#         bus emulator cannot, so the whole bus is pinned to mode 0. This is
+#         the same choice the ArduPilot NucleoF767ZI hwdef makes (MODE0 on all
+#         four SPIDEVs) for the same reason.
+#   -f    bus frequency in kHz. The RM3100 is a 1 MHz part by datasheet, and
+#         the harness's no-dummy protocol (gyro, mag) is only reliable to
+#         ~1.3 MHz; the accel and baro owe a dummy byte and can burst faster.
+#   -R 8  ROTATION_ROLL_180 on the BMI088, and ONLY on the BMI088. PX4's driver
+#         treats the part's native frame as "+x forward, +y left, +z up" and
+#         negates y and z on every sample; ArduPilot's passes xyz straight
+#         through and lets the board rotation do all the work. The harness
+#         emits what ArduPilot's driver wants (it was written against it, and
+#         against a real sensor board's mounting), so PX4 needs one more
+#         180-degree roll to land back on those raw axes. Without it the
+#         accelerometer reads +9.81 m/s2 on Z at rest and EKF2 settles at
+#         roll 180 -- the aircraft is upside down as far as it is concerned.
+#         The RM3100 needs no such correction: both drivers agree on its
+#         axes, and the emulated field checks out in FRD (x=H*cos(psi),
+#         y=-H*sin(psi), z=+Z) against the model heading.
+#------------------------------------------------------------------------------
+
+bmi088 -A -s -b 3 -m 0 -f 4000 -R 8 start
+bmi088 -G -s -b 3 -m 0 -f 1000 -R 8 start
+bmp388 -s -b 3 -m 0 -f 4000 start
+rm3100 -s -b 3 -m 0 -f 1000 -R 0 start
