+ * OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED
+ * AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT
+ * LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN
+ * ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ *
+ ****************************************************************************/
+
+#include <px4_arch/spi_hw_description.h>
+#include <drivers/drv_sensor.h>
+#include <nuttx/spi/spi.h>
+
+/* One bus: SPI3 (PB3 SCK / PB4 MISO / PB5 MOSI) with four chip selects on
+ * port D. Every device on it is the rotanimb01 harness pretending to be
+ * silicon, so the chip selects are the harness's demux inputs:
+ *
+ *   PD3 accel   PD4 gyro   PD5 baro   PD6 mag
+ *
+ * There are no DRDY lines: the harness's interrupt pins are not wired to the
+ * DUT, so all four drivers run on their internal poll schedules. Identical
+ * to the ArduPilot NucleoF767ZI hwdef, which the same harness flies.
+ *
+ * Bus mode and speed are NOT set here -- PX4 takes them from the driver.
+ * These parts are all started with `-m 0` (SPI mode 0) from rc.board_sensors:
+ * a real BMI088/BMP390/RM3100 auto-detects the clock phase per transaction,
+ * a register-level bus emulator cannot, so the whole bus is pinned to mode 0.
+ */
+constexpr px4_spi_bus_t px4_spi_buses[SPI_BUS_MAX_BUS_ITEMS] = {
+	initSPIBus(SPI::Bus::SPI3, {
+		initSPIDevice(DRV_ACC_DEVTYPE_BMI088, SPI::CS{GPIO::PortD, GPIO::Pin3}),
+		initSPIDevice(DRV_GYR_DEVTYPE_BMI088, SPI::CS{GPIO::PortD, GPIO::Pin4}),
+		initSPIDevice(DRV_BARO_DEVTYPE_BMP388, SPI::CS{GPIO::PortD, GPIO::Pin5}),
+		initSPIDevice(DRV_MAG_DEVTYPE_RM3100, SPI::CS{GPIO::PortD, GPIO::Pin6}),
+	}),
+};
+
+static constexpr bool unused = validateSPIConfig(px4_spi_buses);
diff --git a/boards/st/nucleo-f767zi/src/timer_config.cpp b/boards/st/nucleo-f767zi/src/timer_config.cpp
