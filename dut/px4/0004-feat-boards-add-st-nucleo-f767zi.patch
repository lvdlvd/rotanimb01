+#define DMAMAP_SPI3_TX    DMAMAP_SPI3_TX_1    // DMA1, Stream 5, Channel 0    (sensor bus TX)
+//      AVAILABLE                             // DMA1, Stream 6
+//      AVAILABLE                             // DMA1, Stream 7
+
+//  DMA2 Channel/Stream Selections
+//--------------------------------------------//---------------------------//----------------
+//      AVAILABLE                             // DMA2, Stream 0
+#define DMAMAP_USART6_RX  DMAMAP_USART6_RX_1  // DMA2, Stream 1, Channel 5    (spare link RX) 
+//      AVAILABLE                             // DMA2, Streams 2..5
+#define DMAMAP_USART6_TX  DMAMAP_USART6_TX_1  // DMA2, Stream 6, Channel 5    (spare link TX) 
+//      AVAILABLE                             // DMA2, Stream 7
