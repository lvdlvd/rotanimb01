+/* DMA stream/channel allocation for the NUCLEO-F767ZI HITL DUT.
+ *
+ * Only four peripherals need DMA here: the emulated sensor bus (SPI3), the
+ * ST-LINK VCP console (USART3) and the spare link (USART6). The PWM banks
+ * (TIM3/TIM4) are driven by PX4's io_timer without DMA, and there is no SDMMC.
+ *
+ *   DMA1 Stream 0 Ch 0   SPI3_RX_1
+ *   DMA1 Stream 1 Ch 4   USART3_RX     (no alternative mapping)
+ *   DMA1 Stream 3 Ch 4   USART3_TX_1
+ *   DMA1 Stream 5 Ch 0   SPI3_TX_1
+ *   DMA2 Stream 1 Ch 5   USART6_RX_1
+ *   DMA2 Stream 6 Ch 5   USART6_TX_1
+ */
+
+// DMA1 Channel/Stream Selections
+//--------------------------------------------//---------------------------//----------------
+#define DMAMAP_SPI3_RX    DMAMAP_SPI3_RX_1    // DMA1, Stream 0, Channel 0    (sensor bus RX)
+//      DMAMAP_USART3_RX                      // DMA1, Stream 1, Channel 4    (console RX)
+//      AVAILABLE                             // DMA1, Stream 2
+#define DMAMAP_USART3_TX  DMAMAP_USART3_TX_1  // DMA1, Stream 3, Channel 4    (console TX)
