# rotanimb01 — HITL sensor simulator for ArduPlane (see ../DESIGN.md).
# STM32G474RET6 (LQFP64, 64-pin breakout), built on [N]Array.

PART      = STM32G474
PARTFULL  = STM32G474RET6
MEMTARGET = STM32G474Exx_RAM

LIB    = ../../n-array/lib
PERIPH = ../../n-array/periph/stm32g4
NARRAY = ../../n-array/gen/narray

PREFIX  = arm-none-eabi-
CC      = $(PREFIX)gcc
OBJCOPY = $(PREFIX)objcopy
SIZE    = $(PREFIX)size

ARCH    = -mcpu=cortex-m4 -mthumb -mfloat-abi=hard -mfpu=fpv4-sp-d16
CFLAGS  = -std=gnu23 -O2 -g3 -ffreestanding -ffunction-sections -fdata-sections \
          $(ARCH) -Wall -Wextra -Wno-pedantic -I. -I$(LIB)
LDFLAGS = -nostartfiles -lnosys $(ARCH) -T $(MEMTARGET).ld -Wl,-L,. -Wl,-L,$(LIB) \
          -Wl,--gc-sections,-Map,rotanimb01.map

CSRC = main.c board.c $(LIB)/pwm.c $(LIB)/fdcan.c $(LIB)/spislave.c $(LIB)/gpio.c $(LIB)/clock.c $(LIB)/console.c \
       $(LIB)/fault.c $(LIB)/tprintf.c

# generated by narray (delete to regenerate)
GEN = device.h pinmux.h devs.ld $(MEMTARGET).ld

$(NARRAY): $(wildcard ../../n-array/gen/*.go)
	cd ../../n-array/gen && go build -o narray .

device.h: $(NARRAY)
	$(NARRAY) -part $(PART) -header $(PERIPH) > $@

pinmux.h: $(NARRAY)
	$(NARRAY) -pinmux $(PERIPH) > $@

devs.ld: $(NARRAY)
	$(NARRAY) -part $(PART) -devs $(PERIPH) > $@

$(MEMTARGET).ld: $(NARRAY)
	$(NARRAY) -memory $(MEMTARGET) $(PERIPH) > $@

rotanimb01.elf: $(GEN) $(CSRC) board.h $(LIB)/sections.ld
	$(CC) $(CFLAGS) $(CSRC) $(LDFLAGS) -o $@
	$(SIZE) $@

rotanimb01.bin: rotanimb01.elf
	$(OBJCOPY) -O binary $< $@

.DEFAULT_GOAL := rotanimb01.bin

# regenerate the in-file pinout annotations from the datasheet
pinfmt: $(NARRAY) pinmux.h
	$(NARRAY) -part $(PARTFULL) -pinfmt board.c $(PERIPH)

# Flash over ST-Link with OpenOCD (G4 flash is driven by the stm32l4x cmd set).
flash: rotanimb01.elf
	openocd \
		-f interface/stlink.cfg \
		-f target/stm32g4x.cfg \
		-c init \
		-c halt \
		-c "flash probe 0" \
		-c "stm32l4x mass_erase 0" \
		-c "sleep 100" \
		-c "program $< verify" \
		-c reset \
		-c shutdown

clean:
	rm -f *.o *.elf *.bin *.hex *.map $(GEN)

.PHONY: flash clean pinfmt

# a failed "narray ... > $@" must not leave a truncated target behind
.DELETE_ON_ERROR:
